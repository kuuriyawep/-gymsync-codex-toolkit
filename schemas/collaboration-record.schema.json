{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gymsync-codex-toolkit:schema:collaboration-record",
  "title": "Codex Agent Collaboration Audit Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "interaction_id",
    "event_type",
    "status",
    "workflow_id",
    "task_id",
    "sender",
    "recipient",
    "created_at",
    "purpose",
    "scope",
    "request",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "type": "string",
      "pattern": "^CR-[a-z0-9-]+$"
    },
    "interaction_id": {
      "type": "string",
      "pattern": "^CI-[a-z0-9-]+$"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "consultation_requested",
        "consultation_responded",
        "consultation_declined",
        "review_requested",
        "review_submitted",
        "disagreement_raised",
        "disagreement_resolved",
        "incident_escalated",
        "incident_acknowledged",
        "incident_closed"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "responded",
        "declined",
        "submitted",
        "unresolved",
        "resolved",
        "escalated",
        "acknowledged",
        "closed"
      ]
    },
    "workflow_id": {
      "type": "string",
      "minLength": 3
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "sender": {
      "type": "string",
      "enum": [
        "codex",
        "repo_explorer",
        "planner",
        "implementer",
        "reviewer",
        "security_auditor",
        "test_engineer"
      ]
    },
    "recipient": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "codex",
        "repo_explorer",
        "planner",
        "implementer",
        "reviewer",
        "security_auditor",
        "test_engineer",
        null
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "type": "string",
      "minLength": 3
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_scope",
        "write_scope"
      ],
      "properties": {
        "read_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "write_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "request": {
      "type": "string",
      "minLength": 3
    },
    "response": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "related_record_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CR-[a-z0-9-]+$"
      }
    },
    "position": {
      "type": [
        "string",
        "null"
      ]
    },
    "codex_decision": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "outcome",
        "rationale",
        "decided_at"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "accept",
            "reject",
            "defer",
            "needs_more_evidence",
            "no_action"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 5
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "approval_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "severity": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info",
        null
      ]
    },
    "dedupe_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 8
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "disagreement_resolved"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "codex_decision": {
            "type": "object"
          }
        },
        "required": [
          "codex_decision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "incident_escalated"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "dedupe_fingerprint": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "severity",
          "dedupe_fingerprint"
        ]
      }
    }
  ]
}
