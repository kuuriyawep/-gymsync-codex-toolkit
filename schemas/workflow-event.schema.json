{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gymsync-codex-toolkit:schema:workflow-event",
  "title": "Workflow Ledger Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "seq",
    "event_id",
    "timestamp",
    "actor",
    "event_type",
    "idempotency_key",
    "previous_hash",
    "payload",
    "event_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 8
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "minLength": 2
    },
    "event_type": {
      "type": "string",
      "enum": [
        "workflow_created",
        "workflow_transitioned",
        "checkpoint_saved",
        "task_created",
        "task_transitioned",
        "approval_requested",
        "approval_granted",
        "approval_denied",
        "retry_recorded",
        "timeout_recorded",
        "cancellation_requested",
        "workflow_cancelled",
        "evidence_recorded",
        "validation_recorded",
        "review_recorded"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8
    },
    "previous_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objective": {
          "type": "string"
        },
        "primary_workflow": {
          "type": "string"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "complexity": {
          "type": "string",
          "enum": [
            "simple",
            "moderate",
            "complex"
          ]
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "from_state": {
          "type": "string",
          "enum": [
            "INTAKE",
            "TRIAGE",
            "DISCOVERY",
            "PLANNING",
            "APPROVAL",
            "AWAITING_APPROVAL",
            "EXECUTION",
            "VALIDATION",
            "REVIEW",
            "COMPLETION",
            "NEEDS_CLARIFICATION",
            "BLOCKED",
            "FAILED",
            "CANCELLING",
            "CANCELLED"
          ]
        },
        "to_state": {
          "type": "string",
          "enum": [
            "INTAKE",
            "TRIAGE",
            "DISCOVERY",
            "PLANNING",
            "APPROVAL",
            "AWAITING_APPROVAL",
            "EXECUTION",
            "VALIDATION",
            "REVIEW",
            "COMPLETION",
            "NEEDS_CLARIFICATION",
            "BLOCKED",
            "FAILED",
            "CANCELLING",
            "CANCELLED"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "INTAKE",
            "TRIAGE",
            "DISCOVERY",
            "PLANNING",
            "APPROVAL",
            "AWAITING_APPROVAL",
            "EXECUTION",
            "VALIDATION",
            "REVIEW",
            "COMPLETION",
            "NEEDS_CLARIFICATION",
            "BLOCKED",
            "FAILED",
            "CANCELLING",
            "CANCELLED"
          ]
        },
        "summary": {
          "type": "string"
        },
        "next_action": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "task_id": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "task_objective": {
          "type": "string"
        },
        "task_state": {
          "type": "string",
          "enum": [
            "pending",
            "ready",
            "active",
            "completed",
            "blocked",
            "failed",
            "cancelled"
          ]
        },
        "read_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "idempotent": {
          "type": "boolean"
        },
        "approval_required": {
          "type": "boolean"
        },
        "approval_status": {
          "type": "string",
          "enum": [
            "not-required",
            "pending",
            "approved",
            "denied"
          ]
        },
        "approval_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_required": {
          "type": "boolean"
        },
        "validation_status": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "skipped"
          ]
        },
        "review_status": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "skipped"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "deadline_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        },
        "details": {
          "type": "string"
        }
      }
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
