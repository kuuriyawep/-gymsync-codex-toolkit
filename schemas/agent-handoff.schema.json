{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gymsync-codex-toolkit:schema:agent-handoff",
  "title": "Codex Agent Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "task",
    "recipient",
    "objective",
    "scope",
    "context",
    "approval",
    "constraints",
    "expected_output",
    "dependencies"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^H-[a-z0-9-]+$"
    },
    "task": {
      "type": "string",
      "minLength": 5
    },
    "recipient": {
      "type": "string",
      "enum": [
        "repo_explorer",
        "planner",
        "implementer",
        "reviewer",
        "security_auditor",
        "test_engineer"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_scope",
        "out_of_scope"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "out_of_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "assumptions",
        "unknowns"
      ],
      "properties": {
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "note"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 2
              },
              "note": {
                "type": "string",
                "minLength": 3
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approved_scope",
        "approval_reference"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not-required",
            "pending",
            "approved",
            "denied"
          ]
        },
        "approved_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "permission_profile",
        "write_scope",
        "no_go_actions"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "read-only",
            "scoped-write"
          ]
        },
        "permission_profile": {
          "type": "string",
          "minLength": 2
        },
        "write_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "no_go_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "required_sections"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "markdown",
            "json"
          ]
        },
        "required_sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocked_by",
        "parallel_safe"
      ],
      "properties": {
        "blocked_by": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "parallel_safe": {
          "type": "boolean"
        }
      }
    }
  }
}
