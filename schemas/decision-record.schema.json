{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gymsync-codex-toolkit:schema:decision-record",
  "title": "Engineering Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "context", "decision", "consequences"],
  "properties": {
    "id": { "type": "string", "pattern": "^ADR-[0-9]{4}$" },
    "title": { "type": "string", "minLength": 3 },
    "status": {
      "type": "string",
      "enum": ["proposed", "accepted", "rejected", "superseded"]
    },
    "date": { "type": "string", "format": "date" },
    "context": { "type": "string", "minLength": 10 },
    "decision": { "type": "string", "minLength": 10 },
    "alternatives": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "consequences": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "owner": { "type": "string" },
    "review_trigger": { "type": "string" }
  }
}
