{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gymsync-codex-toolkit:schema:agent-result",
  "title": "Codex Agent Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "agent",
    "outcome",
    "summary",
    "work_performed",
    "findings",
    "changed_files",
    "checks",
    "risks",
    "next_action",
    "approval_needed"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^H-[a-z0-9-]+$"
    },
    "agent": {
      "type": "string",
      "enum": [
        "repo_explorer",
        "planner",
        "implementer",
        "reviewer",
        "security_auditor",
        "test_engineer"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 5
    },
    "work_performed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "evidence_refs"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 3
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "severity",
          "status",
          "location",
          "evidence_refs",
          "impact",
          "remediation"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "likely",
              "question",
              "informational"
            ]
          },
          "location": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "impact": {
            "type": "string",
            "minLength": 3
          },
          "remediation": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "changed_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "not_run"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 3
    },
    "approval_needed": {
      "type": "boolean"
    },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_frame",
        "options_considered",
        "rationale",
        "assumptions"
      ],
      "properties": {
        "problem_frame": {
          "type": "string",
          "minLength": 5
        },
        "options_considered": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 5
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "self_critique": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uncertainties",
        "missing_evidence",
        "counterexamples",
        "failure_modes"
      ],
      "properties": {
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counterexamples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tools_used": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "status",
          "purpose"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "available_not_used",
              "invoked_succeeded",
              "invoked_failed",
              "unavailable",
              "not_authorized"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 3
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources_consulted",
        "proposed_updates"
      ],
      "properties": {
        "sources_consulted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proposed_updates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "content",
              "provenance",
              "reason"
            ],
            "properties": {
              "content": {
                "type": "string",
                "minLength": 3
              },
              "provenance": {
                "type": "string",
                "minLength": 3
              },
              "reason": {
                "type": "string",
                "minLength": 3
              }
            }
          }
        }
      }
    },
    "collaboration": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent",
          "purpose",
          "status"
        ],
        "properties": {
          "agent": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "type": "string",
            "enum": [
              "requested",
              "received",
              "declined",
              "unavailable",
              "not_needed"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "interaction_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^CI-[a-z0-9-]+$"
            }
          },
          "decision_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "unresolved_conflicts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    },
    "initiative_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposal_type",
          "title",
          "reason",
          "evidence_refs",
          "benefit",
          "risk",
          "effort",
          "recommended_status"
        ],
        "properties": {
          "proposal_type": {
            "type": "string",
            "enum": [
              "problem",
              "improvement",
              "opportunity"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "reason": {
            "type": "string",
            "minLength": 5
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "benefit": {
            "type": "string",
            "minLength": 3
          },
          "risk": {
            "type": "string",
            "minLength": 3
          },
          "effort": {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "large",
              "unknown"
            ]
          },
          "recommended_status": {
            "type": "string",
            "enum": [
              "accept_for_triage",
              "defer",
              "reject"
            ]
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria_assessed",
        "overall_status",
        "limitations"
      ],
      "properties": {
        "criteria_assessed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion",
              "status",
              "evidence_refs"
            ],
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "blocked",
                  "not_run",
                  "not_applicable"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "rationale": {
                "type": "string"
              }
            }
          }
        },
        "overall_status": {
          "type": "string",
          "enum": [
            "pass",
            "partial",
            "blocked",
            "fail",
            "not_run"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
