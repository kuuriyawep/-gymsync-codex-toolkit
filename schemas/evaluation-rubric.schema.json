{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gymsync-codex-toolkit:schema:evaluation-rubric",
  "title": "Codex Toolkit Evaluation Rubric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "evaluation_method",
    "criteria"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "evaluation_method": {
      "type": "string",
      "enum": [
        "deterministic-check",
        "human-review",
        "hybrid"
      ]
    },
    "scoring_scale": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "score",
          "label",
          "definition"
        ],
        "properties": {
          "score": {
            "type": "integer",
            "minimum": 0
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass_minimum",
        "max_score",
        "minimum_dimension_score",
        "hard_fail_overrides_score"
      ],
      "properties": {
        "pass_minimum": {
          "type": "integer",
          "minimum": 0
        },
        "max_score": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_dimension_score": {
          "type": "integer",
          "minimum": 0
        },
        "hard_fail_overrides_score": {
          "type": "boolean"
        }
      }
    },
    "hard_fail_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "coverage_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_skill",
        "minimums"
      ],
      "properties": {
        "target_skill": {
          "type": "string",
          "minLength": 1
        },
        "minimums": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "in-scope",
            "near-miss",
            "edge"
          ],
          "properties": {
            "in-scope": {
              "type": "integer",
              "minimum": 0
            },
            "near-miss": {
              "type": "integer",
              "minimum": 0
            },
            "edge": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "critical",
          "applies_to"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "description": {
            "type": "string",
            "minLength": 5
          },
          "critical": {
            "type": "boolean"
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
