{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gymsync-codex-toolkit:schema:evaluation-rubric",
  "title": "Codex Toolkit Evaluation Rubric",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "evaluation_method", "criteria"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 3 },
    "evaluation_method": { "type": "string", "enum": ["deterministic-check", "human-review", "hybrid"] },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "critical"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "description": { "type": "string", "minLength": 5 },
          "critical": { "type": "boolean" },
          "applies_to": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
