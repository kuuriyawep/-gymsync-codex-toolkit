{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gymsync-codex-toolkit:schema:workflow-snapshot",
  "title": "Workflow Ledger Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "objective",
    "primary_workflow",
    "state",
    "complexity",
    "risk",
    "scope",
    "acceptance_criteria",
    "approval_required",
    "approval_status",
    "approved_scope",
    "approval_reference",
    "review_required",
    "validation_status",
    "review_status",
    "tasks",
    "checkpoint",
    "seq",
    "last_event_hash",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "objective": {
      "type": "string",
      "minLength": 5
    },
    "primary_workflow": {
      "type": "string",
      "minLength": 2
    },
    "state": {
      "type": "string",
      "enum": [
        "INTAKE",
        "TRIAGE",
        "DISCOVERY",
        "PLANNING",
        "APPROVAL",
        "AWAITING_APPROVAL",
        "EXECUTION",
        "VALIDATION",
        "REVIEW",
        "COMPLETION",
        "NEEDS_CLARIFICATION",
        "BLOCKED",
        "FAILED",
        "CANCELLING",
        "CANCELLED"
      ]
    },
    "complexity": {
      "type": "string",
      "enum": [
        "simple",
        "moderate",
        "complex"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "approval_required": {
      "type": "boolean"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "not-required",
        "pending",
        "approved",
        "denied"
      ]
    },
    "approved_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_required": {
      "type": "boolean"
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed",
        "skipped"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed",
        "skipped"
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "owner",
          "objective",
          "state",
          "read_scope",
          "write_scope",
          "depends_on",
          "attempt",
          "max_attempts",
          "idempotent",
          "approval_status",
          "approval_reference",
          "evidence_refs",
          "summary",
          "next_action"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 2
          },
          "owner": {
            "type": "string",
            "minLength": 2
          },
          "objective": {
            "type": "string",
            "minLength": 5
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "active",
              "completed",
              "blocked",
              "failed",
              "cancelled"
            ]
          },
          "read_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "write_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1
          },
          "idempotent": {
            "type": "boolean"
          },
          "approval_status": {
            "type": "string",
            "enum": [
              "not-required",
              "pending",
              "approved",
              "denied"
            ]
          },
          "approval_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "next_action": {
            "type": "string"
          }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "next_action",
        "evidence_refs",
        "blockers"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "next_action": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "last_event_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
