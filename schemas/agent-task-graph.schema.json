{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gymsync-codex-toolkit:schema:agent-task-graph",
  "title": "Codex Agent Task Dependency Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "max_parallel_tasks",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "graph_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "max_parallel_tasks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "objective",
          "read_scope",
          "write_scope",
          "depends_on",
          "approval_status",
          "approved_scope",
          "approval_reference",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "owner": {
            "type": "string",
            "enum": [
              "repo_explorer",
              "planner",
              "implementer",
              "reviewer",
              "security_auditor",
              "test_engineer"
            ]
          },
          "objective": {
            "type": "string",
            "minLength": 5
          },
          "read_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "write_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "approval_status": {
            "type": "string",
            "enum": [
              "not-required",
              "pending",
              "approved",
              "denied"
            ]
          },
          "approved_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approval_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "planned",
              "ready",
              "in_progress",
              "complete",
              "blocked",
              "failed"
            ]
          }
        }
      }
    }
  }
}
